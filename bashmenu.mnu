version: 0.0.1
title: Bash Menu
options:
- type: divider
  length: '{window_width}'
  char: '{ascii:196}'
- label: Applications
  icon: "{nf::#f003b:\U0001F3AE}"
  submenu:
    title: Applications
    options:
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Antigravity
      icon: '{nf:#EE9FB0:}'
      type: script
      action: /home/andrew/.local/bin/agy
      interactive: true
      quiet: true
    - label: Built-In Text Editor
      icon: '{nf::#f11e7}'
      type: editor
      show_whitespace: true
      tabstop: 4
    - label: Copilot
      icon: '{nf::#F0372}'
      type: command
      action: copilot
      interactive: true
      quiet: true
    - label: Gemini [New Session]
      icon: '{nf::#F1A0}'
      type: command
      action: gemini
      interactive: true
      quiet: true
    - label: Gemini [Resume Last Session]
      icon: '{nf::#F1A0}'
      type: command
      action: gemini --resume latest
      interactive: true
      quiet: true
    - label: Glow
      type: command
      action: glow -t {home}/cheat
      interactive: true
      quiet: true
      icon: '{nf::#eeab:}'
    - label: Midnight Commander
      icon: '{nf::#f0ab6}'
      type: script
      action: /usr/bin/mc
      interactive: true
      quiet: true
    - label: Search Nerd Font & Emoji [{scripts_dir}/glyphs.sh]
      type: script
      action: '{scripts_dir}/glyphs.sh {param}'
      stream: true
      icon: '{nf::#f422}'
    - label: Unicode Block Explorer
      type: script
      action: '{scripts}/unicode.sh'
      icon: '{nf::#f0ed0:}'
      stream: false
      quiet: true
      interactive: true
    - label: View ASCII Symbols [Standard and Extended]
      type: script
      action: '{scripts_dir}/ascii.sh'
      icon: '{nf::#f07ef:}'
      stream: true
      quiet: true
    - label: View Colors
      type: script
      action: '{scripts_dir}/ncurses_colors.py'
      icon: '{nf::#f0301:}'
      stream: true
      quiet: true
      external: true
    - label: Vim
      icon: '{nf::#e62b}'
      type: command
      action: vim
      interactive: true
      quiet: true
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Back to Main Menu
      icon: '{nf::#f048}'
      type: back
- label: Install
  icon: "{nf:::\U0001F4E5}"
  submenu:
    title: Install Tools Menu
    options:
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Apt update && upgrade
      type: command
      action: sudo apt update && sudo apt upgrade -y
      stream: false
      interactive: true
      user_mode: root
      quiet: true
      icon: '{nf::#f487}'
    - label: Install autoexec.sh Launcher
      type: inject_block
      template: '{templates_dir}/autoexec.sh.tmpl'
      target: ~/.bashrc
      block_id: launch_autoexec
      refresh: false
      icon: '{nf::#ead3}'
    - label: Install bash_aliases From Template
      type: inject_block
      template: '{templates_dir}/bash_aliases.tmpl'
      target: ~/.bash_aliases
      block_id: bash_aliases
      refresh: false
      icon: '{nf::#eeb6}'
    - label: Install Basics [apt install vim mc htop glow gum curl wget git shellcheck
        shfmt]
      type: command
      user_mode: root
      action: apt install -y vim mc htop glow gum curl wget git shellcheck shfmt
      stream: true
      icon: '{nf::#ed5b}'
    - label: Install Cheatsheets From Private Repo [https://github.com/HappyAmos/cheat.git]
      type: script
      action: '{scripts_dir}/install_cheat.sh'
      stream: true
      icon: '{nf::#f02aa}'
    - label: Install kmscon [{scripts_dir}/install_kmscon.sh]
      type: script
      action: '{scripts_dir}/install_kmscon.sh'
      stream: true
      icon: '{nf::#f0e51}'
    - label: Install Scripts From Private Repo [https://github.com/HappyAmos/scripts.git]
      type: script
      action: '{scripts_dir}/install_scripts.sh'
      stream: true
      icon: '{nf::#ee79}'
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Back to Main Menu
      type: back
      icon: '{nf::#f048}'
- label: Network Utilities
  icon: "{nf:::\U0001F310}"
  submenu:
    title: Network Utilities Options
    options:
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Configure DNS servers [dnsconfig.sh]
      type: script
      action: '{scripts_dir}/dnsconfig.sh {settings.dns.ipv4.primary} {settings.dns.ipv4.secondary}
        {settings.dns.ipv6.primary} {settings.dns.ipv6.secondary}'
      stream: true
      icon: '{nf::#f0b8c}'
    - label: Configure Ping Target [{settings.ping_target}]
      type: config
      key: settings.ping_target
      title: Edit Ping Target
      prompt: 'Enter Hostname or IP Address:'
      icon: '{nf::#f11ab}'
    - label: Ping Target [{settings.ping_target}]
      type: confirm
      title: Confirm Ping Task
      message: Start pinging target host {settings.ping_target}?
      on_yes:
        type: command
        action: ping -c 4 {settings.ping_target}
        stream: true
      on_no:
        type: message
        title: Task Cancelled
        message: Ping request was cancelled by user.
      icon: '{nf::#f11ab}'
    - label: Show Configured DNS [getdns.py]
      type: script
      action: '{scripts_dir}/getdns.py'
      stream: true
      icon: '{nf::#f01d6}'
    - label: Show Hostname Information [hostname]
      type: command
      action: hostname
      icon: '{nf::#f08ad}'
    - label: Show Network Interfaces [ip a]
      type: command
      action: ip a
      icon: '{nf::#ef09}'
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Back to Main Menu
      type: back
      icon: '{nf::#f048}'
- label: Options & Settings
  icon: "{nf:::\u2699\uFE0F}"
  submenu:
    title: Options & Settings
    options:
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Bashmenu Settings
      submenu:
        title: Bashmenu Settings
        options:
        - type: divider
          length: '{window_width}'
          char: '{ascii:196}'
        - label: Change Theme
          type: theme_selector
        - label: Edit Configuration File [bashmenu.yml]
          type: editor
          action: bashmenu.yml
          show_whitespace: true
        - label: Edit Menu Layout [bashmenu.mnu]
          type: editor
          action: bashmenu.mnu
          show_whitespace: true
        - label: Edit Scripts [{scripts_dir}]
          type: editor
          action: '{scripts_dir}/{file_picker}'
        - label: Edit Templates [{templates_dir}]
          type: editor
          action: '{templates_dir}/{file_picker}'
          show_whitespace: true
        - label: Edit Themes File [bashmenu.themes]
          type: editor
          action: bashmenu.themes
        - label: Enable Automatic Updates (git pull) [{settings.check_for_updates}]
          type: toggle
          key: settings.check_for_updates
          title: Toggle Auto Update
          message: Enable automatic updates?
          icon: '{nf:::}'
        - label: Enable Nerd Fonts [{settings.use_nerd_fonts}]
          type: toggle
          key: settings.use_nerd_fonts
          title: Toggle Nerd Fonts
          message: Enable colorful menu emojis and Nerd Fonts?
          icon: '{nf:::}'
        - label: Editor Tab to Spaces Mode [{settings.tab_to_spaces}]
          type: toggle
          key: settings.tab_to_spaces
          title: Configure Tab Mode
          prompt: 'Convert TAB key to spaces? (true/false):'
        - label: Editor Tabstop Distance [{settings.tabstop}]
          type: config
          key: settings.tabstop
          title: Configure Tabstop Distance
          prompt: 'Enter tabstop distance (spaces per TAB press):'
        - label: Visual Menu Editor [menuedit.py]
          type: script
          action: menuedit.py
          interactive: true
          quiet: true
          refresh: true
          external: false
        - type: divider
          length: '{window_width}'
          char: '{ascii:196}'
        - label: Back to Options & Settings
          type: back
          icon: '{nf::#f048}'
      icon: '{nf::#f013}'
    - label: Edit autoexec.sh [{home}/autoexec.sh]
      type: editor
      action: '{home}/autoexec.sh'
      icon: '{nf::#f11e7}'
    - label: Edit .bashrc [{bashrc}]
      type: editor
      action: '{bashrc}'
      show_whitespace: true
      icon: '{nf::#f11e7}'
    - label: Edit .bash_aliases [{bash_aliases}]
      type: editor
      action: '{bash_aliases}'
      show_whitespace: true
      icon: '{nf::#f11e7}'
    - label: Edit .vimrc [{vimrc}]
      type: editor
      action: '{vimrc}'
      show_whitespace: false
      tabstop: 4
      icon: '{nf::#f11e7}'
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Back to Main Menu
      type: back
      icon: '{nf::#f048}'
- label: System Information
  icon: "{nf:::\u2139\uFE0F}"
  submenu:
    title: System Information Options
    options:
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Check Disk Usage [df -h]
      type: command
      action: df -h
    - label: Check RAM Usage [free -h]
      type: command
      action: free -h
    - label: Check USB Controller [lsusb -vt]
      type: command
      action: lsusb -vt
      stream: true
      quiet: true
    - label: Display CPU Information [lscpu]
      type: command
      action: lscpu
      quiet: true
      stream: true
    - label: Display All PCI Devices [lspci]
      type: command
      action: lspci
      quiet: true
      stream: true
    - label: Which [which [param]]
      type: command
      action: which {param}
      stream: true
      quiet: true
      icon: ''
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Back to Main Menu
      type: back
- label: Help [glow -p bashmenu.md]
  icon: "{nf:::\u2753}"
  type: command
  action: glow -p {bashmenu_dir}/bashmenu.md
  interactive: true
  quiet: true
- label: Exit Menu
  icon: "{nf:::\U0001F6AA}"
  type: exit
- type: divider
  length: '{window_width}'
  char: '{ascii:196}'
