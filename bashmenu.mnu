version: 0.0.1
title: Bash Menu
options:
- type: divider
  length: '{window_width}'
  char: '{ascii:196}'
- label: Applications
  icon: '{nf::#f003b:}'
  submenu:
    title: Applications
    options:
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Antigravity
      icon: '{nf::#eb44:}'
      type: script
      action: '{home}/.local/bin/agy'
      interactive: true
      quiet: true
      tabstop: 4
      stream: false
      masked: false
      show_whitespace: false
      refresh: false
    - label: Brow6el
      type: script
      action: '{home}/github/brow6el/build/brow6el'
      icon: '{nf::#f059f:}'
      interactive: true
      quiet: true
    - label: Built-In Text Editor
      icon: '{nf::#f11e7}'
      type: editor
      show_whitespace: true
      tabstop: 4
    - label: Copilot
      icon: '{nf::#F0372}'
      type: command
      action: copilot
      interactive: true
      quiet: true
    - label: Carbonyl [https://duckduckgo.com]
      type: command
      action: carbonyl https://duckduckgo.com
      icon: '{nf::#f059f:}'
      interactive: true
      quiet: true
    - label: Gemini [New Session]
      icon: '{nf::#F1A0}'
      type: command
      action: gemini
      interactive: true
      quiet: true
    - label: Gemini [Resume Last Session]
      icon: '{nf::#F1A0}'
      type: command
      action: gemini --resume latest
      interactive: true
      quiet: true
    - label: Glow
      type: command
      action: glow -t {home}/cheat
      interactive: true
      quiet: true
      icon: '{nf::#eeab:}'
      command: glow -t {home}/cheat
      tabstop: 4
      stream: false
      alt_buffer: true
      no_formatting: false
      masked: false
      refresh: false
    - label: Midnight Commander
      icon: '{nf::#f0ab6}'
      type: script
      action: /usr/bin/mc
      interactive: true
      quiet: true
    - label: Search Nerd Font & Emoji [{scripts_dir}/glyphs.sh]
      type: script
      action: '{scripts_dir}/glyphs.sh {param}'
      stream: true
      icon: '{nf::#f422}'
    - label: Unicode Block Explorer
      type: script
      action: '{scripts_dir}/unicode.sh'
      icon: '{nf::#f0ed0:}'
      interactive: true
      quiet: true
    - label: View ASCII Symbols [Standard and Extended]
      type: script
      action: '{scripts_dir}/ascii.sh'
      icon: '{nf::#f07ef:}'
      stream: true
      quiet: true
    - label: View Colors
      type: script
      action: '{scripts_dir}/ncurses_colors.py'
      icon: '{nf::#f0301:}'
      stream: true
      quiet: true
      external: true
    - label: Vim
      icon: '{nf::#e62b}'
      type: command
      action: vim
      interactive: true
      quiet: true
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Back to Main Menu
      icon: '{nf::#f048}'
      type: back
      tabstop: 4
      stream: false
      interactive: true
      quiet: false
      alt_buffer: true
      no_formatting: false
      masked: false
      refresh: false
      show_whitespace: false
      external: false
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - type: submenu
      title: Internet
      submenu:
        title: New submenu
        options: []
      tabstop: 4
      stream: false
      interactive: true
      quiet: false
      alt_buffer: true
      no_formatting: false
      masked: false
      refresh: false
      show_whitespace: false
      external: false
      icon: '{nf::#f059f}'
  type: submenu
  tabstop: 4
  stream: false
  interactive: true
  quiet: false
  alt_buffer: true
  no_formatting: false
  masked: false
  refresh: false
  show_whitespace: false
  external: false
- type: submenu
  title: Experiments
  submenu:
    title: New submenu
    options:
    - type: divider
      char: '{ascii:196}'
      length: '{window_width}'
    - type: command
      title: proot Alpine Linux
      command: proot-distro login alpine
      tabstop: 4
      stream: false
      interactive: true
      quiet: false
      alt_buffer: true
      no_formatting: false
      masked: false
      refresh: false
      show_whitespace: false
      external: false
    - type: divider
      char: '{ascii:196}'
      length: '{window_width}'
    - type: back
      title: Back To Main Menu
      tabstop: 4
      stream: false
      interactive: true
      quiet: false
      alt_buffer: true
      no_formatting: false
      masked: false
      refresh: false
      show_whitespace: false
      external: false
      icon: '{nf::#f048}'
    - type: divider
      char: '{ascii:196}'
      length: '{window_width}'
  action: Experiments
  tabstop: 4
  stream: false
  interactive: true
  quiet: false
  alt_buffer: false
  no_formatting: false
  masked: false
  refresh: false
  show_whitespace: false
  external: false
  icon: '{nf::#f0668}'
- label: Games
  submenu:
    title: Games
    options:
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: BSD Games
      type: script
      action: '{scripts_dir}/bsdgames.sh'
      icon: '{nf::#f30c:}'
      interactive: true
      quiet: true
    - label: Console Games
      type: command
      action: '{scripts_dir}/games.sh'
      icon: '{nf::#f11b:}'
      interactive: true
      quiet: true
    - label: QBasic Gorillas Clone
      type: script
      action: python3 {scripts_dir}/gorillas.py
      icon: '{nf::#f1e2:}'
      interactive: true
      quiet: true
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Back to Main Menu
      type: back
      icon: '{nf::#f048}'
      tabstop: 4
      stream: false
      interactive: true
      quiet: false
      alt_buffer: true
      no_formatting: false
      masked: false
      refresh: false
      show_whitespace: false
      external: false
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
  icon: '{nf::#f003b:}'
  type: submenu
  tabstop: 4
  stream: false
  interactive: true
  quiet: false
  alt_buffer: true
  no_formatting: false
  masked: false
  refresh: false
  show_whitespace: false
  external: false
- label: Install
  icon: '{nf::#f01da:}'
  submenu:
    title: Install Tools Menu
    options:
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Apt update && upgrade
      type: script
      action: '{scripts_dir}/system_update.sh'
      stream: false
      interactive: true
      quiet: true
      icon: '{nf::#f487}'
    - label: Install autoexec.sh Launcher
      type: inject_block
      template: '{templates_dir}/autoexec.sh.tmpl'
      target: ~/.bashrc
      block_id: launch_autoexec
      refresh: false
      icon: '{nf::#ead3}'
    - label: Install bash_aliases From Template
      type: inject_block
      template: '{templates_dir}/bash_aliases.tmpl'
      target: ~/.bash_aliases
      block_id: bash_aliases
      refresh: false
      icon: '{nf::#eeb6}'
    - label: Install Basics [vim mc htop glow gum curl wget git shellcheck shfmt jq
        yq]
      type: submenu
      action: '{scripts_dir}/install_basics.sh'
      stream: true
      icon: '{nf::#ed5b}'
      submenu:
        title: Install Basics [vim mc htop glow gum curl wget git shellcheck shfmt
          jq yq]
        options: []
    - label: Install Brow6el [https://tangled.org/janantos.tngl.sh/brow6el/raw/main/download_cef.sh]
      type: command
      action: bash -c "$(curl -fsSL https://tangled.org/janantos.tngl.sh/brow6el/raw/main/download_cef.sh)"
      icon: '{nf::#f059f:}'
      interactive: true
    - label: Install Cheatsheets From Private Repo [https://github.com/HappyAmos/cheat.git]
      type: script
      action: '{scripts_dir}/install_cheat.sh'
      stream: true
      icon: '{nf::#f02aa}'
    - label: Install Kitty [curl -L https://sw.kovidgoyal.net/kitty/installer.sh |
        sh /dev/stdin]
      type: command
      action: curl -L https://sw.kovidgoyal.net/kitty/installer.sh | sh /dev/stdin
      icon: '{nf::#f26b:}'
      interactive: true
      quiet: true
    - label: Install Games [{scripts_dir}/install_games.sh]
      type: script
      action: '{scripts_dir}/install_games.sh'
      icon: '{nf::#f11b:}'
      external: true
      interactive: true
    - label: Install kmscon [{scripts_dir}/install_kmscon.sh]
      type: script
      action: '{scripts_dir}/install_kmscon.sh'
      stream: true
      icon: '{nf::#f0e51}'
    - label: Install Nerd Fonts [curl https://raw.githubusercontent.com/officialrajdeepsingh/nerd-fonts-installer/main/install.sh]
      type: command
      action: bash -c "$(curl -fsSL https://raw.githubusercontent.com/officialrajdeepsingh/nerd-fonts-installer/main/install.sh)"
      icon: '{nf::#eb54:}'
      interactive: true
    - label: Install Scripts From Private Repo [https://github.com/HappyAmos/scripts.git]
      type: script
      action: '{scripts_dir}/install_scripts.sh'
      stream: true
      icon: '{nf::#ee79}'
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Back to Main Menu
      type: back
      icon: '{nf::#f048}'
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
  type: submenu
  tabstop: 4
  stream: false
  interactive: true
  quiet: false
  alt_buffer: true
  no_formatting: false
  masked: false
  refresh: false
  show_whitespace: false
  external: false
- type: submenu
  title: Internet
  icon: '{nf::#f059f}'
  submenu:
    title: Internet Options
    options:
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - type: command
      title: Github.com
      command: '{scripts_dir}/webopen.sh https://github.com'
      tabstop: 4
      stream: false
      interactive: true
      quiet: false
      alt_buffer: true
      no_formatting: false
      masked: false
      refresh: false
      show_whitespace: false
      external: false
      icon: '{nf::#ea84}'
    - type: script
      title: Google.com
      script: '{scripts_dir}/webopen.sh https://google.com'
      tabstop: 4
      stream: false
      interactive: true
      quiet: false
      alt_buffer: true
      no_formatting: false
      masked: false
      refresh: false
      show_whitespace: false
      external: false
      icon: '{nf::#f02ad}'
    - label: Launch GUI Web Browser [{scripts_dir}/webopen.sh --gui]
      type: command
      action: '{scripts_dir}/webopen.sh --gui'
      icon: '{nf::#f268:}'
      interactive: true
      quiet: true
      alt_buffer: true
      command: '{scripts_dir}/webopen.sh --gui'
      tabstop: 4
      stream: false
      no_formatting: false
      masked: false
      refresh: false
      show_whitespace: false
      external: false
    - label: Launch Terminal Web Browser [{scripts_dir}/webopen.sh --tty]
      type: command
      action: '{scripts_dir}/webopen.sh --tty'
      icon: '{nf::#f120:}'
      interactive: true
      quiet: true
      alt_buffer: true
      command: '{scripts_dir}/webopen.sh --tty'
      tabstop: 4
      stream: false
      no_formatting: false
      masked: false
      refresh: false
      show_whitespace: false
      external: false
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Back to Main Menu
      type: back
      icon: '{nf::#f048}'
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
- label: Network Utilities
  icon: '{nf::#ef09:}'
  submenu:
    title: Network Utilities Options
    options:
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Configure DNS servers [dnsconfig.sh]
      type: script
      action: '{scripts_dir}/dnsconfig.sh {settings.dns.ipv4.primary} {settings.dns.ipv4.secondary}
        {settings.dns.ipv6.primary} {settings.dns.ipv6.secondary}'
      stream: true
      icon: '{nf::#f0b8c}'
    - label: Configure Ping Target [{settings.ping_target}]
      type: config
      key: settings.ping_target
      title: Edit Ping Target
      prompt: 'Enter Hostname or IP Address:'
      icon: '{nf::#f11ab}'
    - label: IP Information
      type: script
      action: '{scripts_dir}/ip_info.sh'
      icon: '{nf::#F0A5F:}'
      interactive: false
      stream: true
    - label: Ping Target [{settings.ping_target}]
      type: confirm
      title: Confirm Ping Task
      message: Start pinging target host {settings.ping_target}?
      on_yes:
        type: command
        action: '{scripts_dir}/ping.sh {settings.ping_target}'
        stream: true
      on_no:
        type: message
        title: Task Cancelled
        message: Ping request was cancelled by user.
      icon: '{nf::#f11ab}'
      prompt: Start pinging target host {settings.ping_target}?
      tabstop: 4
      stream: false
      interactive: true
      quiet: false
      alt_buffer: true
      no_formatting: false
      masked: false
      refresh: false
    - label: Show Configured DNS [getdns.py]
      type: script
      action: '{scripts_dir}/getdns.py'
      stream: true
      icon: '{nf::#f01d6}'
    - label: Show Hostname Information [hostname]
      type: command
      action: hostname
      icon: '{nf::#f08ad}'
    - label: Show Network Interfaces [ip a]
      type: command
      action: ip a
      icon: '{nf::#ef09}'
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Back to Main Menu
      type: back
      icon: '{nf::#f048}'
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
  type: submenu
  tabstop: 4
  stream: false
  interactive: true
  quiet: false
  alt_buffer: true
  no_formatting: false
  masked: false
  refresh: false
  show_whitespace: false
  external: false
- label: Options & Settings
  icon: '{nf::#f423:}'
  submenu:
    title: Options & Settings
    options:
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: '[b]Bashmenu Settings[/b]'
      submenu:
        title: Bashmenu Settings
        options:
        - type: divider
          length: '{window_width}'
          char: '{ascii:196}'
        - label: Change Theme
          type: theme_selector
          icon: '{nf::#f03d8}'
        - label: Edit Configuration File [bashmenu.yml]
          type: editor
          action: bashmenu.yml
          icon: '{nf::#f1de}'
          show_whitespace: true
        - label: Edit Menu Layout [bashmenu.mnu]
          type: editor
          action: bashmenu.mnu
          icon: '{nf::#f0279}'
          show_whitespace: true
        - label: Edit Scripts [{scripts_dir}]
          type: editor
          action: '{scripts_dir}/{file_picker_new}'
          icon: '{nf::#eae9}'
          file: '{file_picker_new}'
          start_dir: '{scripts_dir}'
          tabstop: 4
          stream: false
          interactive: true
          quiet: false
          alt_buffer: true
          no_formatting: false
          masked: false
          refresh: false
        - label: Edit Templates [{templates_dir}]
          type: editor
          action: '{templates_dir}/{file_picker}'
          icon: '{nf::#f09ee}'
          show_whitespace: true
          file: '{file_picker}'
          start_dir: '{templates_dir}'
          tabstop: 4
          stream: false
          interactive: true
          quiet: false
          alt_buffer: true
          no_formatting: false
          masked: false
          refresh: false
        - label: Edit Themes File [bashmenu.themes]
          type: editor
          action: bashmenu.themes
          icon: '{nf::#e22b}'
          file: '{bashmenu_dir}/bashmenu.themes'
          tabstop: 4
          stream: false
          interactive: true
          quiet: false
          alt_buffer: true
          no_formatting: false
          masked: false
          refresh: false
        - label: Enable Automatic Updates (git pull) [{settings.check_for_updates}]
          type: toggle
          key: settings.check_for_updates
          title: Toggle Auto Update
          message: Enable automatic updates?
          icon: '{nf::#ea77}'
        - label: Enable Nerd Fonts [{settings.use_nerd_fonts}]
          type: toggle
          key: settings.use_nerd_fonts
          title: Toggle Nerd Fonts
          message: Enable colorful menu emojis and Nerd Fonts?
          icon: '{nf::#f031}'
        - label: Nerd Font Display Width [{settings.nerd_font_width}]
          type: config
          key: settings.nerd_font_width
          title: Configure Nerd Font Glyph Width
          prompt: 'Enter Nerd Font character width mode (auto, 1, 2):'
          icon: '{nf::#f07e}'
        - label: Editor Tab to Spaces Mode [{settings.tab_to_spaces}]
          type: toggle
          key: settings.tab_to_spaces
          title: Configure Tab Mode
          prompt: 'Convert TAB key to spaces? (true/false):'
          icon: '{nf::#ec3c}'
        - label: Editor Tabstop Distance [{settings.tabstop}]
          type: config
          key: settings.tabstop
          title: Configure Tabstop Distance
          prompt: 'Enter tabstop distance (spaces per TAB press):'
          icon: '{nf::#ee10}'
        - label: Configure Status Gutter [{settings.status_gutter}]
          type: config
          key: settings.status_gutter
          title: Configure Status Gutter
          prompt: 'Enter status gutter format. Available options: {user}, {battery},
            {date}, {date_time_24}, {date_time_24_short}, {date_time_12}, {date_time_12_short},
            {host}, {user-mode}, {version}, {utc_seconds}'
          icon: '{nf::#ebf3}'
        - label: Visual Menu Editor [menuedit.py]
          type: script
          action: menuedit.py
          icon: '{nf::#f044}'
          interactive: true
          quiet: true
          refresh: true
          external: false
        - type: divider
          length: '{window_width}'
          char: '{ascii:196}'
        - label: Back to Options & Settings
          type: back
          icon: '{nf::#f048}'
        - type: divider
          length: '{window_width}'
          char: '{ascii:196}'
      icon: '{nf::#f013}'
    - label: Edit autoexec.sh [{home}/autoexec.sh]
      type: editor
      action: '{home}/autoexec.sh'
      icon: '{nf::#f11e7}'
    - type: editor
      title: Edit bashmenu.md [{bashmenu_dir}/bashmenu.md]
      file: '{bashmenu_dir}/bashmenu.md'
      tabstop: 4
      stream: false
      interactive: true
      quiet: false
      alt_buffer: true
      no_formatting: false
      masked: false
      refresh: false
      show_whitespace: false
      external: false
      icon: '{nf::#f11e7}'
    - label: Edit .bashrc [{bashrc}]
      type: editor
      action: '{bashrc}'
      show_whitespace: true
      icon: '{nf::#f11e7}'
    - label: Edit .bash_aliases [{bash_aliases}]
      type: editor
      action: '{bash_aliases}'
      show_whitespace: true
      icon: '{nf::#f11e7}'
    - label: Edit .vimrc [{vimrc}]
      type: editor
      action: '{vimrc}'
      show_whitespace: false
      tabstop: 4
      icon: '{nf::#f11e7}'
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Back to Main Menu
      type: back
      icon: '{nf::#f048}'
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
  type: submenu
  tabstop: 4
  stream: false
  interactive: true
  quiet: false
  alt_buffer: true
  no_formatting: false
  masked: false
  refresh: false
  show_whitespace: false
  external: false
- label: System Information
  icon: '{nf::#e66a:}'
  submenu:
    title: System Information Options
    options:
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Check Disk Usage [df -h]
      type: command
      action: df -h
      icon: '{nf::#f02ca:}'
      command: df -h
      tabstop: 4
      stream: true
      quiet: false
      interactive: false
      masked: false
      show_whitespace: false
      refresh: false
    - label: Check RAM Usage [free -h]
      type: command
      action: free -h
      icon: '{nf::#f035b:}'
      command: free -h
      tabstop: 4
      stream: true
      quiet: false
      interactive: false
      masked: false
      show_whitespace: false
      refresh: false
    - label: Check USB Controller [lsusb -vt]
      type: command
      action: lsusb -vt
      stream: true
      quiet: false
      icon: '{nf::#f287:}'
      command: lsusb -vt
      tabstop: 4
      interactive: false
      masked: false
      show_whitespace: false
      refresh: false
    - label: Display Block Devices [lsblk]
      type: command
      action: lsblk
      icon: '{nf::#f233:}'
      stream: true
      command: lsblk
      tabstop: 4
      quiet: false
      interactive: false
      masked: false
      show_whitespace: false
      refresh: false
    - label: Display CPU Information [lscpu]
      type: command
      action: lscpu
      quiet: false
      stream: true
      icon: '{nf::#f2db:}'
      command: lscpu
      tabstop: 4
      interactive: false
      masked: false
      show_whitespace: false
      refresh: false
    - label: Display PCI Devices and Drivers [lspci -k]
      type: command
      action: lspci -k
      quiet: false
      stream: true
      icon: '{nf::#f08ae:}'
      command: lspci -k
      tabstop: 4
      interactive: false
      masked: false
      show_whitespace: false
      refresh: false
    - label: Kernel Information [uname -r]
      type: command
      action: uname -r
      icon: '{nf::#f31a:}'
      stream: true
      quiet: true
    - label: Which [which [param]]
      type: command
      action: which {param}
      stream: true
      quiet: true
      icon: '{nf::#f002:}'
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Back to Main Menu
      type: back
      icon: '{nf::#f048}'
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
  type: submenu
  tabstop: 4
  stream: false
  interactive: true
  quiet: false
  alt_buffer: true
  no_formatting: false
  masked: false
  refresh: false
  show_whitespace: false
  external: false
- label: Weather
  submenu:
    title: Weather
    options:
    - type: divider
      length: '{window_width}'
      char: '{ascii:196}'
    - label: Weather Postal Code [{user.postal_code}]
      type: submenu
      action: Enter Postal Code
      icon: '{nf::#eef0:}'
      interactive: false
      stream: true
      quiet: true
      key: user.postal_code
      title: Weather Location
      prompt: 'Enter your postal code/zip code:'
      picker: none
      submenu:
        title: Weather Location
        options: []
    - label: Weather -> 3 Day [curl wttr.in/{user.postal_code}]
      type: command
      action: curl wttr.in/{user.postal_code}
      icon: '{nf::#eef0:}'
      stream: false
      quiet: false
      interactive: true
      command: curl wttr.in/{user.postal_code}
      tabstop: 4
      no_formatting: false
      masked: false
      refresh: false
      alt_buffer: true
    - label: Weather -> 3 Day v.2. [curl v2.wttr.in/{user.postal_code}]
      type: command
      action: curl v2.wttr.in/{user.postal_code}
      icon: '{nf::#eef0:}'
      interactive: true
      command: curl v2.wttr.in/{user.postal_code}
      tabstop: 4
      stream: false
      quiet: false
      no_formatting: false
      masked: false
      refresh: false
